<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <Title>Raycynix Serilog Aspire AppHost Integration</Title>
        <Description>Aspire 13 AppHost integration for Raycynix Serilog, adding one-line structured logging registration to IDistributedApplicationBuilder while keeping resource-process logging explicit.</Description>
        <PackageTags>raycynix;serilog;logging;structured-logging;aspire;apphost;distributed-application;orchestration;idistributedapplicationbuilder;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="true" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Serilog\Raycynix.Extensions.Serilog.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" Version="13.6.1" />
        <PackageReference Include="Google.Protobuf" Version="3.36.2" />
        <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="10.0.13" />
        <PackageReference Include="OpenTelemetry" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    </ItemGroup>

</Project>
