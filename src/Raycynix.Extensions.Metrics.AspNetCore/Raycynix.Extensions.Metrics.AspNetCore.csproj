<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <Description>Stable OpenTelemetry ASP.NET Core instrumentation for standard Raycynix System.Diagnostics.Metrics instruments, OTLP exporters, and Aspire.</Description>
        <PackageTags>raycynix;metrics;aspnetcore;opentelemetry;otlp;aspire;http;instrumentation;telemetry;dotnet;net10</PackageTags>

        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="false" Visible="false" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Raycynix.Extensions.Metrics\Raycynix.Extensions.Metrics.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="OpenTelemetry" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    </ItemGroup>

</Project>
