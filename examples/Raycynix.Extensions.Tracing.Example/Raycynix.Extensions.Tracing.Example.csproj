<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Raycynix.Extensions.Tracing\Raycynix.Extensions.Tracing.csproj" />
    </ItemGroup>

</Project>
